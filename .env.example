# Configuración de Base de Datos
# Para pruebas locales usa SQLite:
DATABASE_URL=sqlite:///./taqueria.db
# Para producción gratuita 24/7 en Neon.tech o Supabase usa PostgreSQL:
# DATABASE_URL=postgresql://usuario:password@ep-cold-lake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Google Gemini Flash API (Obtén tu clave gratis en https://aistudio.google.com/)
GEMINI_API_KEY=

# Meta WhatsApp Cloud API (https://developers.facebook.com/)
META_VERIFY_TOKEN=taqueria_webhook_secret_token_2026
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# Whitelist de teléfonos autorizados separados por coma (opcional, en blanco permite pruebas)
# AUTHORIZED_PHONES=5215512345678,5215587654321
